# Dockerfile for a self-contained local/CI build of «Аренда БЕЗ».
# Build: docker build -f for_you_Egor -t rent-bez:local .
# Run:   docker run --rm -p 3000:3000 --env-file .env rent-bez:local
#
# Do not put secrets in this file. Supply DATABASE_URL, JWT_SECRET and optional
# integration keys through the environment at runtime.

FROM node:22-slim

WORKDIR /app

# The project uses pnpm and needs devDependencies for the Vite/esbuild build.
COPY . .
RUN npm install -g corepack@latest \
    && corepack pnpm install --frozen-lockfile \
    && corepack pnpm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/index.js"]
